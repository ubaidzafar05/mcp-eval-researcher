FROM node:20-alpine AS deps
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci

FROM node:20-alpine AS builder
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1
ENV NEXT_DISABLE_GOOGLE_FONTS=1
COPY --from=deps /app/node_modules ./node_modules
COPY . .
ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_EXECUTION_MODE
ARG NEXT_PUBLIC_RUNTIME_PROFILE
ARG NEXT_PUBLIC_QUALITY_PROFILE
ARG NEXT_PUBLIC_DEFAULT_THEME
ARG NEXT_PUBLIC_UI_VERSION
ARG NEXT_PUBLIC_SHOW_RAW_SOURCE_LEDGER_DEFAULT
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}
ENV NEXT_PUBLIC_EXECUTION_MODE=${NEXT_PUBLIC_EXECUTION_MODE}
ENV NEXT_PUBLIC_RUNTIME_PROFILE=${NEXT_PUBLIC_RUNTIME_PROFILE}
ENV NEXT_PUBLIC_QUALITY_PROFILE=${NEXT_PUBLIC_QUALITY_PROFILE}
ENV NEXT_PUBLIC_DEFAULT_THEME=${NEXT_PUBLIC_DEFAULT_THEME}
ENV NEXT_PUBLIC_UI_VERSION=${NEXT_PUBLIC_UI_VERSION}
ENV NEXT_PUBLIC_SHOW_RAW_SOURCE_LEDGER_DEFAULT=${NEXT_PUBLIC_SHOW_RAW_SOURCE_LEDGER_DEFAULT}
RUN npm run build

FROM node:20-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV NEXT_DISABLE_GOOGLE_FONTS=1
COPY --from=builder /app/public ./public
COPY --from=builder /app/.next/standalone ./
COPY --from=builder /app/.next/static ./.next/static
EXPOSE 3000
CMD ["node", "server.js"]
